{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jtsc-team-hub",
  "account_id": "f28b3c7ec9dd41face502f174e387dec",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/jtsc-card-assets-20260914/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jtsc-volunteer-crew",
      "database_id": "5b8010c6-1094-453d-9e18-ae9066a27199"
    }
  ]
}
